<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/settings_ui_preview_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="?attr/colorSurfaceBright"
            app:cardCornerRadius="24dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_ui_preview_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/settings_ui_preview_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/settings_ui_preview_body"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/settings_ui_preview_primary"
                        android:backgroundTint="?attr/colorPrimaryContainer"
                        android:background="@drawable/settings_preview_swatch"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:padding="4dp"
                        android:text="@string/settings_ui_preview_primary"
                        android:textAppearance="?attr/textAppearanceLabelLarge" />

                    <TextView
                        android:id="@+id/settings_ui_preview_secondary"
                        android:backgroundTint="?attr/colorSecondaryContainer"
                        android:background="@drawable/settings_preview_swatch"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:padding="4dp"
                        android:text="@string/settings_ui_preview_secondary"
                        android:textAppearance="?attr/textAppearanceLabelLarge" />

                    <TextView
                        android:id="@+id/settings_ui_preview_tertiary"
                        android:backgroundTint="?attr/colorTertiaryContainer"
                        android:background="@drawable/settings_preview_swatch"
                        android:textColor="?attr/colorOnTertiaryContainer"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:padding="4dp"
                        android:text="@string/settings_ui_preview_tertiary"
                        android:textAppearance="?attr/textAppearanceLabelLarge" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settings_ui_preview_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="true"
                    android:text="@string/settings_ui_preview_switch" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_ui_preview_button"
                    style="?attr/materialButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_ui_preview_button" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
