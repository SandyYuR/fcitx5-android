<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Bridge legacy platform color lookups used by existing settings editors to Material 3 roles. -->
    <style name="Theme.FcitxSettings.Base" parent="Theme.Material3Expressive.DynamicColors.DayNight.NoActionBar">
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorPrimary">?attr/colorPrimary</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:colorBackgroundFloating">?attr/colorSurfaceContainerHigh</item>
        <item name="android:colorButtonNormal">?attr/colorSurfaceContainerHigh</item>
        <item name="android:colorControlActivated">?attr/colorPrimary</item>
        <item name="android:colorControlHighlight">?attr/colorSecondaryContainer</item>
        <item name="android:colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="android:colorForeground">?attr/colorOnSurface</item>
        <item name="android:colorForegroundInverse">?attr/colorSurfaceInverse</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColorTertiary">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Theme.FcitxSettings.Base.Light" parent="Theme.Material3Expressive.Light.NoActionBar">
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorPrimary">?attr/colorPrimary</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:colorBackgroundFloating">?attr/colorSurfaceContainerHigh</item>
        <item name="android:colorButtonNormal">?attr/colorSurfaceContainerHigh</item>
        <item name="android:colorControlActivated">?attr/colorPrimary</item>
        <item name="android:colorControlHighlight">?attr/colorSecondaryContainer</item>
        <item name="android:colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="android:colorForeground">?attr/colorOnSurface</item>
        <item name="android:colorForegroundInverse">?attr/colorSurfaceInverse</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColorTertiary">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Theme.FcitxSettings.Base.Dark" parent="Theme.Material3Expressive.Dark.NoActionBar">
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorPrimary">?attr/colorPrimary</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:colorBackgroundFloating">?attr/colorSurfaceContainerHigh</item>
        <item name="android:colorButtonNormal">?attr/colorSurfaceContainerHigh</item>
        <item name="android:colorControlActivated">?attr/colorPrimary</item>
        <item name="android:colorControlHighlight">?attr/colorSecondaryContainer</item>
        <item name="android:colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="android:colorForeground">?attr/colorOnSurface</item>
        <item name="android:colorForegroundInverse">?attr/colorSurfaceInverse</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColorTertiary">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Theme.FcitxSettings.System" parent="Theme.FcitxSettings.Base" />
    <style name="Theme.FcitxSettings.System.Light" parent="Theme.FcitxSettings.Base.Light" />
    <style name="Theme.FcitxSettings.System.Dark" parent="Theme.FcitxSettings.Base.Dark" />

    <style name="Theme.FcitxAppTheme" parent="Theme.MaterialComponents.Light.NoActionBar.Bridge">
        <item name="colorLogFatal">@color/red_A700</item>
        <item name="colorLogError">@color/red_400</item>
        <item name="colorLogWarning">@color/yellow_800</item>
        <item name="colorLogInfo">@color/blue_500</item>
        <item name="colorLogDebug">@color/grey_700</item>
        <item name="colorLogVerbose">@color/grey_700</item>
    </style>

    <style name="Theme.InputViewTheme" parent="@android:style/Theme.DeviceDefault.Settings" />

    <style name="Theme.DialogTheme" parent="@android:style/Theme.DeviceDefault.Light.Dialog" />

    <style name="Theme.TransparentOverlayActivity" parent="Theme.FcitxAppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.18</item>
    </style>

    <style name="InputViewSnackbarTheme" parent="Theme.MaterialComponents.Light.NoActionBar" />
</resources>
