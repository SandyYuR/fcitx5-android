<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Bridge legacy platform color lookups used by existing settings editors to Material 3 roles. -->
    <style name="Theme.FcitxSettings.Base" parent="Theme.Material3Expressive.DynamicColors.DayNight.NoActionBar">
        <item name="textInputStyle">@style/Widget.FcitxSettings.TextField</item>
        <item name="preferenceTheme">@style/ThemeOverlay.FcitxSettings.Preferences</item>
        <item name="preferenceStyle">@style/Preference.FcitxSettings</item>
        <item name="preferenceScreenStyle">@style/Preference.FcitxSettings.Screen</item>
        <item name="preferenceCategoryStyle">@style/Preference.FcitxSettings.Category</item>
        <item name="dialogPreferenceStyle">@style/Preference.FcitxSettings.Dialog</item>
        <item name="editTextPreferenceStyle">@style/Preference.FcitxSettings.EditText</item>
        <item name="switchPreferenceCompatStyle">@style/Preference.FcitxSettings.Switch</item>
        <item name="checkBoxPreferenceStyle">@style/Preference.FcitxSettings.CheckBox</item>
        <item name="toolbarStyle">@style/Widget.FcitxSettings.Toolbar</item>
        <item name="android:windowBackground">?attr/colorSurfaceContainer</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorPrimary">?attr/colorPrimary</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:colorBackgroundFloating">?attr/colorSurfaceContainerHigh</item>
        <item name="android:colorButtonNormal">?attr/colorSurfaceContainerHigh</item>
        <item name="android:colorControlActivated">?attr/colorPrimary</item>
        <item name="android:colorControlHighlight">?attr/colorControlHighlight</item>
        <item name="android:colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="android:colorForeground">?attr/colorOnSurface</item>
        <item name="android:colorForegroundInverse">?attr/colorSurfaceInverse</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColorTertiary">?attr/colorOnSurfaceVariant</item>
        <!-- 日志级别色：日志查看器按级别着色，值随 values-night/colors.xml 切换 -->
        <item name="colorLogFatal">@color/log_level_fatal</item>
        <item name="colorLogError">@color/log_level_error</item>
        <item name="colorLogWarning">@color/log_level_warning</item>
        <item name="colorLogInfo">@color/log_level_info</item>
        <item name="colorLogDebug">@color/log_level_debug</item>
        <item name="colorLogVerbose">@color/log_level_verbose</item>
    </style>

