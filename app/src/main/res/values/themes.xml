    <style name="Theme.InputViewTheme" parent="@android:style/Theme.DeviceDefault.Settings" />

    <style name="Theme.DialogTheme" parent="Theme.Material3Expressive.DayNight.Dialog">
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.TransparentOverlayActivity" parent="Theme.FcitxSettings.System">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.18</item>
    </style>

    <style name="InputViewSnackbarTheme" parent="Theme.MaterialComponents.Light.NoActionBar" />

    <!-- IME service inflaters create a platform Button, which cannot apply the Expressive
         button's MaterialThemeOverlay dimension attributes. Preserve the panel's colors. -->
    <style name="ThemeOverlay.FcitxSettings.Snackbar" parent="">
        <item name="snackbarButtonStyle">@style/Widget.Material3.Button.TextButton.Snackbar</item>
    </style>

    <style name="ThemeOverlay.FcitxSettings.ClipboardMenu" parent="">
        <item name="android:popupMenuStyle">@style/Widget.Material3.PopupMenu</item>
    </style>
