{
  "name": "中州鹅 Android",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "GRADLE_USER_HOME": "/home/vscode/.gradle"
  },
  "mounts": [
    "source=fcitx5-android-gradle-cache,target=/home/vscode/.gradle,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "fwcd.kotlin",
        "vscjava.vscode-gradle",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python"
      ],
      "settings": {
        "java.jdt.ls.java.home": "/usr/lib/jvm/java-17",
        "files.eol": "\n",
        "terminal.integrated.defaultProfile.linux": "bash",
        "cmake.configureOnOpen": false
      }
    }
  }
}
